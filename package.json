{
  "name": "dsh-plan-steps",
  "version": "0.1.18",
  "type": "module",
  "description": "Host-owned plan steps: two-level task lists with stable step ids, one sign-off path, and a plan panel.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg",
    "client.js",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrounzerLiu/dsh-plan-steps.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plan",
    "todo",
    "task-list",
    "agent"
  ],
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
