{
  "name": "dsh-task-steps",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Host-owned task list steps: complete_step signs one item off and advances the list.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "test",
    "README.md",
    "icon.svg",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
